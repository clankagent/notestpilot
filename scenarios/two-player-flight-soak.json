{
  "name": "Two clients fly and fire for fifteen minutes in Escalation",
  "clients": 2,
  "steps": [
    {
      "name": "Host Escalation",
      "target": "server",
      "command": "host",
      "args": {
        "mission": "Escalation",
        "port": 17777
      }
    },
    {
      "name": "Verify the large mission",
      "target": "server",
      "expect": [
        {
          "path": "mission",
          "equals": "Escalation"
        },
        {
          "path": "missionRunning",
          "equals": true
        },
        {
          "path": "units",
          "atLeast": 800
        }
      ]
    },
    {
      "name": "First client joins",
      "target": "client1",
      "command": "connect",
      "args": {
        "port": 17777
      }
    },
    {
      "name": "First client owns its player",
      "target": "client1",
      "expect": [
        {
          "path": "localPlayerNetId",
          "notNull": true
        }
      ]
    },
    {
      "name": "Second client joins",
      "target": "client2",
      "command": "connect",
      "args": {
        "port": 17777
      }
    },
    {
      "name": "Second client owns its player",
      "target": "client2",
      "expect": [
        {
          "path": "localPlayerNetId",
          "notNull": true
        }
      ]
    },
    {
      "name": "Server sees both matching player identities",
      "target": "server",
      "expect": [
        {
          "path": "remotePlayers",
          "equals": 2
        },
        {
          "path": "players.1.netId",
          "equalsFrom": {
            "target": "client1",
            "path": "localPlayerNetId"
          }
        },
        {
          "path": "players.2.netId",
          "equalsFrom": {
            "target": "client2",
            "path": "localPlayerNetId"
          }
        }
      ]
    },
    {
      "name": "First player chooses Primeva",
      "target": "client1",
      "command": "faction",
      "args": {
        "name": "Primeva"
      }
    },
    {
      "name": "Second player chooses Boscali",
      "target": "client2",
      "command": "faction",
      "args": {
        "name": "Boscali"
      }
    },
    {
      "name": "Server confirms both faction decisions",
      "target": "server",
      "expect": [
        {
          "path": "players.1.faction",
          "equals": "Primeva"
        },
        {
          "path": "players.2.faction",
          "equals": "Boscali"
        }
      ]
    },
    {
      "target": "client1",
      "name": "First player reserves an aircraft",
      "command": "reserve"
    },
    {
      "target": "client2",
      "name": "Second player reserves an aircraft",
      "command": "reserve"
    },
    {
      "target": "client1",
      "expect": [
        {
          "atLeast": 1,
          "path": "localPlayerOwnedCount"
        }
      ],
      "name": "First player receives an owned airframe"
    },
    {
      "target": "client2",
      "expect": [
        {
          "atLeast": 1,
          "path": "localPlayerOwnedCount"
        }
      ],
      "name": "Second player receives an owned airframe"
    },
    {
      "target": "client1",
      "name": "First player requests spawning",
      "command": "spawn",
      "args": {
        "airbase": "Sandrift Airbase"
      }
    },
    {
      "target": "client2",
      "name": "Second player requests spawning",
      "command": "spawn",
      "args": {
        "airbase": "Maris Airport"
      }
    },
    {
      "timeout": 120,
      "target": "client1",
      "expect": [
        {
          "notNull": true,
          "path": "localPlayerAircraftNetId"
        }
      ],
      "name": "First client receives its aircraft"
    },
    {
      "timeout": 120,
      "target": "client2",
      "expect": [
        {
          "notNull": true,
          "path": "localPlayerAircraftNetId"
        }
      ],
      "name": "Second client receives its aircraft"
    },
    {
      "target": "server",
      "expect": [
        {
          "equalsFrom": {
            "target": "client1",
            "path": "localPlayerAircraftNetId"
          },
          "path": "players.1.aircraftNetId"
        },
        {
          "equalsFrom": {
            "target": "client2",
            "path": "localPlayerAircraftNetId"
          },
          "path": "players.2.aircraftNetId"
        }
      ],
      "name": "Server matches both client aircraft identities"
    },
    {
      "target": "client1",
      "name": "First player starts its engine",
      "command": "engine",
      "args": {
        "on": true
      }
    },
    {
      "target": "client2",
      "name": "Second player starts its engine",
      "command": "engine",
      "args": {
        "on": true
      }
    },
    {
      "name": "Inspect aircraft and standard loadouts",
      "target": "client1",
      "command": "catalog"
    },
    {
      "name": "Both clients steer, taxi and attempt takeoff for three minutes",
      "target": "server",
      "observe": {
        "seconds": 180,
        "expect": [
          {
            "equals": 2,
            "path": "remotePlayers"
          },
          {
            "notNull": true,
            "path": "players.1.aircraftNetId"
          },
          {
            "notNull": true,
            "path": "players.2.aircraftNetId"
          },
          {
            "equals": false,
            "path": "players.1.disabled"
          },
          {
            "equals": false,
            "path": "players.2.disabled"
          }
        ],
        "motion": [
          {
            "minimumMetres": 100,
            "path": "players.1"
          },
          {
            "minimumMetres": 100,
            "path": "players.2"
          }
        ],
        "actions": [
          {
            "command": "fly",
            "target": "client1",
            "args": {
              "seconds": 45
            },
            "everySeconds": 20
          },
          {
            "command": "fly",
            "target": "client2",
            "args": {
              "seconds": 45
            },
            "everySeconds": 20
          }
        ]
      }
    },
    {
      "name": "Server confirms both aircraft are airborne",
      "target": "server",
      "timeout": 10,
      "expect": [
        {
          "atLeast": 80,
          "path": "players.1.radarAltitude"
        },
        {
          "atLeast": 80,
          "path": "players.2.radarAltitude"
        }
      ]
    },
    {
      "name": "Both owned aircraft remain airborne and fire during fifteen-minute circuit",
      "target": "server",
      "observe": {
        "seconds": 900,
        "expect": [
          {
            "path": "remotePlayers",
            "equals": 2
          },
          {
            "path": "players.1.aircraftNetId",
            "notNull": true
          },
          {
            "path": "players.1.disabled",
            "equals": false
          },
          {
            "path": "players.1.radarAltitude",
            "atLeast": 80
          },
          {
            "path": "players.1.speed",
            "atLeast": 35
          },
          {
            "path": "players.2.aircraftNetId",
            "notNull": true
          },
          {
            "path": "players.2.disabled",
            "equals": false
          },
          {
            "path": "players.2.radarAltitude",
            "atLeast": 80
          },
          {
            "path": "players.2.speed",
            "atLeast": 35
          }
        ],
        "motion": [
          {
            "path": "players.1",
            "minimumMetres": 2000
          },
          {
            "path": "players.2",
            "minimumMetres": 2000
          }
        ],
        "actions": [
          {
            "target": "client1",
            "command": "fly",
            "args": {
              "seconds": 45,
              "fire": true
            },
            "everySeconds": 20
          },
          {
            "target": "client2",
            "command": "fly",
            "args": {
              "seconds": 45,
              "fire": true
            },
            "everySeconds": 20
          }
        ]
      }
    },
    {
      "name": "Server confirms both guns consumed ammunition",
      "target": "server",
      "timeout": 10,
      "expect": [
        {
          "path": "players.1.weapons.0.ammo",
          "atMost": 999
        },
        {
          "path": "players.2.weapons.0.ammo",
          "atMost": 999
        }
      ]
    }
  ]
}
